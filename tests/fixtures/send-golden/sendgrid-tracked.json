      },
      "attachments": [
        {
          "content": "cmVjZWlwdCBib2R5",
          "filename": "receipt.txt",
          "type": "text/plain",
          "disposition": "attachment"
        },
        {
          "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
          "filename": "logo",
          "type": "image/png",
          "disposition": "inline",
          "content_id": "logo"
        }
      ]
    }
  }
}

{
  "version": "4.4.2",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "strapi5",
    "email",
    "smtp",
    "nodemailer",
    "sendgrid",
    "mailgun",
    "gmail",
    "microsoft-graph",
    "email-routing",
    "failover",
    "email-queue",
    "outbox",
    "email-templates",
    "email-tracking",
    "webhooks"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0 <=26.x.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && strapi-plugin build && node scripts/build-server-bundle.mjs",
    "watch": "node scripts/watch.mjs",
    "watch:link": "node scripts/watch.mjs --link",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "test": "node --test tests/*.test.js",
    "test:multi-instance": "node --test tests/multi-instance.test.js tests/multi-instance-units.test.js tests/multi-instance-queue.test.js tests/bounce-monitor.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node .dev/test-magic-mail.js --quick",
    "test:full": "node .dev/test-magic-mail.js --full",
    "prepublishOnly": "npm test && npm run build && npm run verify && npm run verify:runtime"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@strapi/utils": "^5.57.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "mustache": "^4.2.0",
    "nodemailer": "^10.3.1",
    "postal-mime": "^4.1.4",
    "react-email-editor": "^2.1.3",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/plugin-users-permissions": "^5.61.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.0",
    "@strapi/utils": "^5.61.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/plugin-users-permissions": "^5.57.0",
    "@strapi/strapi": "^5.57.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": true
    },
    "@strapi/icons": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "overrides": {
    "ws": "^8.22.0",
    "vite": "^6.4.5",
    "esbuild": "$esbuild",
    "@rushstack/node-core-library": {
      "ajv": "^8.18.0"
    },
    "@semantic-release/github": {
      "undici": "^7.30.2"
    }
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-mail",
    "displayName": "MagicMail - Email Suite",
    "description": "Email routing for Strapi 5: send through several SMTP and API accounts with routing rules, quotas, safe failover, an outbox with retries, templates, tracking and delivery webhooks."
  },
  "name": "strapi-plugin-magic-mail",
  "description": "Email routing for Strapi 5: send through several SMTP and API accounts with routing rules, quotas, safe failover, an outbox with retries, templates, tracking and delivery webhooks.",
  "license": "MIT",
  "author": "Schero D.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schero94/Magic-Mail.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magic-Mail/issues"
  },
  "homepage": "https://schero94.github.io/Magic-Mail/",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

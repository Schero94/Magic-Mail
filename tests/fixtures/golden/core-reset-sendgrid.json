{
  "url": "https://api.sendgrid.com/v3/mail/send",
  "method": "POST",
  "headers": {
    "Authorization": "<redacted>",
    "Content-Type": "application/json"
  },
  "body": {
    "json": {
      "personalizations": [
        {
          "to": [
            {
              "email": "user@example.test"
            }
          ]
        }
      ],
      "from": {
        "email": "noreply@sendgrid.example.test",
        "name": "Strapi Admin"
      },
      "subject": "Reset password",
      "content": [
        {
          "type": "text/plain",
          "value": "<p>We heard that you lost your password.</p><p>https://app.example.test/reset?code=0123456789abcdef</p>"
        },
        {
          "type": "text/html",
          "value": "<p>We heard that you lost your password.</p><p>https://app.example.test/reset?code=0123456789abcdef</p><img src=\"https://track.example.test/api/magic-mail/track/open/emailgolden1\" />"
        }
      ],
      "custom_args": {
        "magicmail_version": "1.0",
        "email_type": "transactional",
        "priority": "normal",
        "magicmail_id": "golddoc1"
      },
      "headers": {
        "X-Mailer": "MagicMail/1.0",
        "X-Email-Type": "transactional"
      },
      "tracking_settings": {
        "open_tracking": {
          "enable": false
        }
      },
      "reply_to": {
        "email": "support@example.test"
      }
    }
  }
}

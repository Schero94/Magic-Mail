{
  "url": "https://api.sendgrid.com/v3/mail/send",
  "method": "POST",
  "headers": {
    "Authorization": "<redacted>",
    "Content-Type": "application/json"
  },
  "body": {
    "json": {
      "personalizations": [
        {
          "to": [
            {
              "email": "ada@example.test"
            },
            {
              "email": "bob@example.test"
            }
          ],
          "cc": [
            {
              "email": "carol@example.test"
            }
          ],
          "bcc": [
            {
              "email": "dave@example.test"
            }
          ]
        }
      ],
      "from": {
        "email": "noreply@sendgrid.example.test",
        "name": "Golden Sender"
      },
      "subject": "Golden order 42",
      "content": [
        {
          "type": "text/plain",
          "value": "Hello\nShop https://shop.example.test/a?x=1"
        },
        {
          "type": "text/html",
          "value": "<p>Hello</p><a href=\"https://track.example.test/c/1\">Shop</a><img src=\"cid:logo\" /><img src=\"https://track.example.test/api/magic-mail/track/open/emailgolden1\" />"
        }
      ],
      "custom_args": {
        "magicmail_version": "1.0",
        "email_type": "transactional",
        "priority": "normal"
      },
      "headers": {
